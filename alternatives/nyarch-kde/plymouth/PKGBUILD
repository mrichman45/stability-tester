package() {
  local f
  for f in "${_files[@]}"; do
    install -Dm644 "$srcdir/$f" "$pkgdir/usr/share/plymouth/themes/nyarch-logo/$f"
  done
  install -Dm644 "$srcdir/LICENSE" "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
