# Boot: systemd-boot with signed unified kernel images (UKI) made by dracut.
sys-kernel/installkernel dracut systemd systemd-boot uki
sys-apps/systemd boot secureboot

# The kernel: built here, modules signed. No "secureboot" flag: on gentoo-kernel it also
# turns on lockdown, and lockdown blocks hibernation. The firmware still checks the boot
# files: dracut signs the whole kernel image (UKI) with your db key (etc/dracut.conf.d).
sys-kernel/gentoo-kernel modules-sign

# NVIDIA: open kernel modules (RTX 40 series), Dynamic Boost daemon for
# legion-system, Wayland, signed modules, 32-bit libraries for Steam.
x11-drivers/nvidia-drivers kernel-open powerd wayland modules-sign abi_x86_32 -persistenced

# Legion fans, Fn+Q modes, battery limit (GURU). systemd, not elogind.
sys-firmware/lenovolegionlinux modules-sign gui -elogind

# Firmware updates through fwupd, with its EFI part signed.
sys-apps/fwupd-efi secureboot

# Japanese typing.
app-i18n/mozc fcitx5

# ntfsfix for ntfs-autofix.
sys-fs/ntfs3g ntfsprogs
